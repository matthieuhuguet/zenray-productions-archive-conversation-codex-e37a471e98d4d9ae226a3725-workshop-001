import { describe, it, expect } from 'vitest'
import { gzipSync } from 'node:zlib'
import { decodeSubtitleText, SUB_ENCODING } from './subtitleSidecar.js'

const pack = (text) => ({ lang: 'fre', format: 'ass', encoding: SUB_ENCODING, data: gzipSync(Buffer.from(text, 'utf8')).toString('base64') })

describe('decodeSubtitleText', () => {
  it('round-trips an ASS text with accents', async () => {
    const ass = '[Script Info]\nTitle: Épisode\nDialogue: 0,0:00:01.00,0:00:02.00,Default,,0,0,0,,Qu\'est-ce qu\'on vient faire ?'
    expect(await decodeSubtitleText(pack(ass))).toBe(ass)
  })
  it('refuses an unknown encoding', async () => {
    await expect(decodeSubtitleText({ encoding: 'rot13', data: 'x' })).rejects.toThrow(/unknown subtitle encoding/)
  })
  it('refuses a spec without data', async () => {
    await expect(decodeSubtitleText({})).rejects.toThrow(/without data/)
  })
})
