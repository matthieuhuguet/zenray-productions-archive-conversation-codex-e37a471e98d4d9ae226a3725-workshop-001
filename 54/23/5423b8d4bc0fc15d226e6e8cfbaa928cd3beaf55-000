// 2 October 2026, 13:36 CEST: publish private project snapshots by identity with fresh conflict-safe writes.
import { assertWorkspaceId } from '../src/lib/projectWorkspace.js'
import { buildGlobalProjectIndex, renderProjectContext } from '../src/lib/projectContextIndex.js'

// 3 October 2026, 10:25 CEST: the shared catalogue omits transfer internals; exact proofs remain in each project snapshot.
export function compactRegistryProject(project) {
  const fields = ['id', 'name', 'relativePath', 'sourceId', 'namespace', 'kind', 'size', 'sha256', 'status',
    'cloudPath', 'contentPath', 'mtimeMs', 'preservedOriginalVersion', 'sourceConflict']
  return { ...project, files: (project.files || []).map((file) => Object.fromEntries(fields.filter((field) => file[field] !== undefined).map((field) => [field, file[field]]))) }
}

export function createAssetsCloudPublisher({ baseUrl, fetchImpl = fetch, secret = process.env.ZENRAY_API_SECRET,
  token = process.env.GITHUB_TOKEN, repository = process.env.CONTENT_REPO || 'matthieuhuguet/zenray-data' } = {}) {
  let tail = Promise.resolve()
  const headers = { 'content-type': 'application/json', ...(secret ? { 'x-zr-auth': secret } : {}) }
  const save = async (filePath, mutate, { text = false } = {}) => {
    for (let attempt = 0; attempt < 5; attempt++) {
      const read = await fetchImpl(`${baseUrl}/api/page?action=read&path=${encodeURIComponent(filePath)}`, { headers, cache: 'no-store' })
      if (!read.ok && read.status !== 404) throw new Error(`Cloud registry read failed (${read.status}) at ${filePath}`)
      const current = await read.json()
      if (current.error && !current.missing && read.status !== 404) throw new Error('Cloud registry read failed')
      // 2 October 2026, 20:20 CEST: read the immutable blob matching the edit SHA; branch raw CDN can return stale bytes.
      if (current.sha && !current.markdown) {
        if (!token) throw new Error('GitHub credential unavailable for large registry read')
        const raw = await fetchImpl(`https://api.github.com/repos/${repository}/git/blobs/${current.sha}`, {
          headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-assets' }, cache: 'no-store' })
        const body = await raw.json()
        if (!raw.ok || body.sha !== current.sha || body.encoding !== 'base64' || !body.content) throw new Error('Cloud registry body unavailable; refusing to overwrite existing data')
        current.markdown = Buffer.from(body.content, 'base64').toString('utf8')
      }
      const data = text ? current.markdown || '' : current.markdown ? JSON.parse(current.markdown) : {}
      const next = mutate(data)
      const write = await fetchImpl(`${baseUrl}/api/page`, { method: 'POST', headers,
        body: JSON.stringify({ action: 'save', path: filePath, sha: current.sha || null, markdown: text ? next : JSON.stringify(next) }) })
      const result = await write.json()
      if (write.ok && result.ok) return next
      if (result.conflict || write.status === 409) continue
      // 3 October 2026, 21:57 CEST: a partial publication identifies its failed document instead of claiming a complete checkpoint.
      throw new Error(`Cloud registry save failed (${write.status}) at ${filePath}: ${result.error || "unexpected response"} ${result.detail || ""}`)
    }
    throw new Error('Cloud registry changed repeatedly; publication can be retried')
  }
  return (snapshot) => {
    assertWorkspaceId(snapshot.id)
    const run = async () => {
      await save(`${snapshot.folder}/.workspace.json`, () => snapshot)
      const registry = await save('pages/.zr-assets-workspaces.json', (current) => {
        const projects = [...(current.projects || []).filter((project) => project.id !== snapshot.id), snapshot].map(compactRegistryProject)
        return { ...current, schemaVersion: 3, updatedAt: new Date().toISOString(), projects, index: buildGlobalProjectIndex(projects, { cloud: true }) }
      })
      await save(`${snapshot.folder}/.context.md`, () => renderProjectContext(registry.index, snapshot.id), { text: true })
    }
    const task = tail.then(run, run)
    tail = task.catch(() => {})
    return task
  }
}
