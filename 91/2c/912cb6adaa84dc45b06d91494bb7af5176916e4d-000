import { describe, expect, it } from 'vitest'
import { RAW_THRESHOLD } from '../../src/config/chunkPolicy.js'
import { bornerRailMemoire, isPermanentPushRejection, normaliserRailArchive, shouldFlushChunkBatch, shouldFlushStreamBatch } from './archive-route.mjs'

describe('routage mémoire bornée', () => {
  it('nomme le rail vidéo selon la sauvegarde exacte sans modifier les autres rails', () => {
    expect(normaliserRailArchive('hls')).toBe('video')
    expect(normaliserRailArchive('img')).toBe('img')
  })

  it('garde les petits aperçus et bascule les gros fichiers vers le flux chunké', () => {
    expect(bornerRailMemoire('img', RAW_THRESHOLD)).toBe('img')
    expect(bornerRailMemoire('media', RAW_THRESHOLD + 1)).toBe('chunk')
    expect(bornerRailMemoire('img', RAW_THRESHOLD + 1)).toBe('chunk')
    expect(bornerRailMemoire('video', RAW_THRESHOLD * 100)).toBe('video')
    expect(bornerRailMemoire('chunk', RAW_THRESHOLD * 100)).toBe('chunk')
  })

  it('groupe les manifestes jusqu’au seuil de taille ou de temps', () => {
    expect(shouldFlushStreamBatch(1, 256, 1_000, 30_999, 30_000)).toBe(false)
    expect(shouldFlushStreamBatch(1, 256, 1_000, 31_000, 30_000)).toBe(true)
    expect(shouldFlushStreamBatch(256, 256, 31_000, 31_001, 30_000)).toBe(true)
    expect(shouldFlushStreamBatch(0, 256, 1_000, 99_000, 30_000)).toBe(false)
  })

  it('groupe les petits fichiers jusqu’au seuil de données à pousser', () => {
    expect(shouldFlushChunkBatch(19, 20)).toBe(false)
    expect(shouldFlushChunkBatch(20, 20)).toBe(true)
    expect(shouldFlushChunkBatch(21, 20)).toBe(true)
  })

  it('arrête seulement sur un refus distant explicitement définitif', () => {
    expect(isPermanentPushRejection('remote: repository is over its size limit')).toBe(true)
    expect(isPermanentPushRejection('remote: GH013 Repository rule violations found')).toBe(true)
    expect(isPermanentPushRejection('Could not resolve host: github.com')).toBe(false)
    expect(isPermanentPushRejection('s')).toBe(false)
  })
})
