// 2 October 2026, 15:25 CEST: local text previews have one shared format and size policy.
export const PROJECT_PREVIEW_CONFIG = {
  textMaxBytes: 262144,
  textExtensions: ['md', 'txt', 'json', 'jsonl', 'log', 'csv', 'yaml', 'yml', 'py', 'js', 'mjs', 'ts', 'tsx', 'jsx', 'css', 'html', 'ini', 'toml', 'usf', 'ush', 'vfl'],
}
export function isTextPreviewFile(name) {
  return PROJECT_PREVIEW_CONFIG.textExtensions.includes(String(name).split('.').pop().toLowerCase())
}
