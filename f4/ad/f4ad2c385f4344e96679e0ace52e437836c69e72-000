            padding: '7px 11px', borderRadius: LEGENDE.rayonRectangle, background: LEGENDE.fond,
            font: `400 ${LEGENDE.tailleNote}px/1.28 var(--zr-police-sans)`, color: '#fff',
            overflow: 'hidden', display: '-webkit-box', WebkitLineClamp: 3, WebkitBoxOrient: 'vertical',
