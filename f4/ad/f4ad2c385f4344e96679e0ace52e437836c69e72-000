            overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap',
            ...(cliquable.style || {}),
          }}>{title}
            {/* Le comptage d'un groupe vit DANS la capsule, pas à côté : posé en bas à droite comme
                au premier passage, il passait sous le rectangle de note dès qu'un groupe en portait
                une. Un seul élément ne peut pas se chevaucher lui-même. Nombre en Serif Regular 400,
                la règle du trio typographique pour tout nombre visible. */}
            {compte != null ? <span style={{ marginLeft: 7, opacity: .62, font: `400 ${LEGENDE.tailleTitre - 2}px var(--zr-police-serif)` }}>{compte}</span> : null}
          </h3>
        </div>
      ) : null}
      {url ? (
        <div style={{ position: 'absolute', top: title ? 36 : 8, left: 8, zIndex: 3, pointerEvents: 'auto' }}>
          <a href={url} target="_blank" rel="noopener noreferrer"
            onClick={(e) => e.stopPropagation()}
            title={`Ouvrir le lien source (${url})`}
            style={{
              display: 'inline-flex', alignItems: 'center', gap: 4,
              padding: '2px 8px', borderRadius: 999, background: 'rgba(0,0,0,.65)',
              color: 'rgba(255,255,255,.95)', textDecoration: 'none',
              font: '400 11px/1.2 var(--zr-police-sans)',
              backdropFilter: 'blur(6px)', WebkitBackdropFilter: 'blur(6px)',
              boxShadow: '0 1px 3px rgba(0,0,0,.3)',
