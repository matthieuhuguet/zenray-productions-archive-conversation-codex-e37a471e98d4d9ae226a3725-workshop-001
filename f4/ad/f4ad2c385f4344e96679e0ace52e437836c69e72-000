// ÉDITEUR TITRE + NOTE — un seul composant, posé par-dessus la tuile concernée, images et groupes
// confondus. Il remplace l'ancien champ de renommage seul : deux façons de nommer la même chose
// auraient divergé au premier ajout de champ.
//
// LA FERMETURE SE TESTE SUR LA CIBLE DU FOCUS, jamais sur le simple fait de perdre le focus : passer
// du titre à la note est un blur, et fermer là-dessus rendrait la note impossible à écrire.
// `currentTarget.contains(relatedTarget)` distingue « je suis sorti de l'éditeur » de « je circule
// dedans ». ⌘Entrée valide, Échap annule.
function TileEditor({ item, onSave, onCancel }) {
  // Un GROUPE se nomme par `name` (son identité : fil d'Ariane, menu « Déplacer vers… »). Une IMAGE
  // se légende par `title`, distinct de son `name` hérité du nom de fichier. Voir TileCaption.
  const estGroupe = item.kind === 'folder'
  const [title, setTitle] = React.useState((estGroupe ? item.name : item.title) || '')
  const [url, setUrl] = React.useState(item.url || '')
  const [note, setNote] = React.useState(item.note || '')
  const champ = {
    width: '100%', boxSizing: 'border-box', background: TILE_EDITOR_GLASS.field, color: '#fff',
    border: '1px solid rgba(255,255,255,.22)', borderRadius: 5, padding: '5px 7px', outline: 'none',
  }
  return (
    <div onClick={(e) => e.stopPropagation()} onDragStart={(e) => e.stopPropagation()}
      onKeyDown={(e) => {
        if (e.key === 'Escape') { e.stopPropagation(); onCancel() }
        if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.stopPropagation(); onSave({ name: title.trim(), url: url.trim(), note: note.trim() }) }
      }}
      onBlur={(e) => { if (!e.currentTarget.contains(e.relatedTarget)) onSave({ name: title.trim(), url: url.trim(), note: note.trim() }) }}
      style={{
        position: 'absolute', inset: 0, zIndex: 5, display: 'flex', flexDirection: 'column', gap: 6,
        padding: 10, borderRadius: 4, background: TILE_EDITOR_GLASS.overlay,
        backdropFilter: TILE_EDITOR_GLASS.blur, WebkitBackdropFilter: TILE_EDITOR_GLASS.blur,
      }}>
      <input autoFocus value={title} onChange={(e) => setTitle(e.target.value)} placeholder={estGroupe ? 'Nom du groupe' : 'Titre (laisse vide pour n’afficher aucun titre)'}
        aria-label="Titre" style={{ ...champ, font: '350 14px var(--zr-police-serif)' }} />
      {!estGroupe && (
        <input value={url} onChange={(e) => setUrl(e.target.value)} placeholder="Lien source (ArtStation, YouTube, web…)"
          aria-label="Lien source" style={{ ...champ, font: '400 12px var(--zr-police-sans)' }} />
      )}
      <textarea value={note} onChange={(e) => setNote(e.target.value)} placeholder="Note : la description, ce que cette référence règle"
        aria-label="Note" style={{ ...champ, flex: 1, resize: 'none', font: '400 12px/1.4 var(--zr-police-sans)' }} />
      <div style={{ font: '400 10px var(--zr-police-sans)', color: 'rgba(255,255,255,.5)' }}>⌘↵ valider · Échap annuler</div>
    </div>
  )
}

// TUILE DE GROUPE — mini-collage 2×2 des images qu'il contient, comme un dossier iOS : on continue de
// VOIR ce qu'il y a dedans plutôt que de le cacher derrière une icône abstraite. Zéro nouveau rendu :
// les 4 cases réutilisent GalleryThumb, exactement la vignette d'une image seule.
//
// CE QUI DISTINGUE UN GROUPE D'UNE IMAGE, après trois passages et deux corrections de Matthieu : le
// collage lui-même, et la pastille qui compte les éléments. RIEN D'AUTRE. J'ai essayé successivement
// un fond clair avec marge interne, puis un biseau `zr-liquid-rim`, et les deux ont été refusés dans
// les mêmes termes — « tu commences à ajouter plein d'effet c'est moche », puis « le gros liseré
// moche est toujours présent ». La marge interne dessinait un cadre blanc épais que je prenais pour
// une aide à la lecture ; sur un mur de références, elle salissait la grille entière.
//
// LE LISERÉ EST CELUI DE LA SIDEBAR, `.zr-ws-rim` (corrigé le 2026-08-21). J'avais d'abord posé
// `zr-liquid-rim`, et Matthieu a tranché : « je voulais les bords liseré du sidebar thème sombre,
// enlève le reste, tu commences à ajouter plein d'effet c'est moche ». Les deux classes sont des
// familles opposées et c'est là que je m'étais trompé : `zr-liquid-rim` est un BISEAU pour carte
// opaque (highlight 1,5px, ombre interne, halo, ombre portée de 32px), quand la sidebar porte un
// simple FILET d'un pixel qu'on voit à peine. Sur une grille de références, le biseau salissait
// toutes les tuiles à la fois. Voir `src/fonts.css`, .zr-ws-rim.
function FolderTile({ folder, editing, onOpen, onEdit, onSave, onCancel, dragProps, ratio = '4 / 5' }) {
  const kids = (folder.items || []).slice(0, 4)
  const n = (folder.items || []).length
  return (
    <div {...dragProps} style={{ width: '100%', position: 'relative', ...(dragProps?.style || {}) }}>
      <div className="zr-tap zr-ws-rim" onClick={onOpen} style={{
        width: '100%', aspectRatio: ratio, cursor: 'pointer', position: 'relative',
        borderRadius: 8, overflow: 'hidden',
      }}>
        {/* LE COLLAGE VA BORD À BORD. Il vivait en retrait de 6 px sur un fond `t.surface`, ce qui
            dessinait un CADRE BLANC ÉPAIS autour de chaque groupe — c'est ce que Matthieu appelait
            « le gros liseré moche », et je l'avais pris pour l'ombre portée. Le seul bord d'un groupe
            est désormais le filet d'un pixel de .zr-ws-rim, exactement celui de la sidebar.

            LA GRILLE SUIT LE NOMBRE D'ENFANTS. Figée en 2×2, un groupe de deux images laissait deux
            cases vides, soit la moitié de la tuile en aplat — le vide se voyait plus que les images. */}
        <div style={{
          width: '100%', height: '100%', display: 'grid', gap: 2,
          gridTemplateColumns: kids.length < 2 ? '1fr' : '1fr 1fr',
          gridTemplateRows: kids.length < 3 ? '1fr' : '1fr 1fr',
        }}>
          {kids.map((k) => (
            <GalleryThumb key={k.id} path={k.path} alt="" style={{ width: '100%', height: '100%', objectFit: 'cover', display: 'block' }} />
          ))}
        </div>
        <TileCaption title={folder.name} note={folder.note} onEdit={onEdit} compte={n} />
        {editing ? <TileEditor item={folder} onSave={onSave} onCancel={onCancel} /> : null}
      </div>
    </div>
  )
}

// ── CASE POUR COPIER DES LIENS AVEC APERÇU (2026-10-02, demande de Matthieu) ───────────────────────
// Permet de coller une URL (ArtStation, YouTube, Pinterest, blog, etc.) avec aperçu automatique
// de la miniature et des métadonnées, OU de glisser / coller (⌘V) directement une image copiée
// (par exemple depuis ArtStation où le bot est bloqué par Cloudflare).
function GalleryLinkBox({ t, label, onAddReference }) {
  const [open, setOpen] = React.useState(false)
  const [urlInput, setUrlInput] = React.useState('')
  const [loading, setLoading] = React.useState(false)
  const [preview, setPreview] = React.useState(null)
  const [customImage, setCustomImage] = React.useState(null) // dataUrl
  const [customFile, setCustomFile] = React.useState(null) // File / Blob
  const [title, setTitle] = React.useState('')
  const [note, setNote] = React.useState('')
  const [dragOverDropzone, setDragOverDropzone] = React.useState(false)
  const [submitting, setSubmitting] = React.useState(false)
  const fileInputRef = React.useRef(null)

  const handleFetch = async (targetUrl) => {
    const raw = (targetUrl || urlInput || '').trim()
    if (!raw) return
    let parsedUrl = raw
    if (!/^https?:\/\//i.test(parsedUrl) && (parsedUrl.includes('.') || parsedUrl.includes('localhost'))) {
      parsedUrl = 'https://' + parsedUrl
    }
    setLoading(true)
    try {
      const r = await fetch(`/api/unfurl?url=${encodeURIComponent(parsedUrl)}`).then((res) => res.json()).catch(() => null)
      if (r && !r.error) {
        setPreview(r)
        if (r.title && !title) setTitle(r.title)
        if (r.description && !note) setNote(r.description)
        setOpen(true)
      } else {
        const host = (() => { try { return new URL(parsedUrl).hostname.replace(/^www\./, '') } catch { return 'Lien' } })()
        setPreview({ url: parsedUrl, title: host, image: null, siteName: host })
        if (!title) setTitle(host)
        setOpen(true)
      }
    } catch {
      const host = (() => { try { return new URL(parsedUrl).hostname.replace(/^www\./, '') } catch { return 'Lien' } })()
      setPreview({ url: parsedUrl, title: host, image: null, siteName: host })
      if (!title) setTitle(host)
      setOpen(true)
    } finally {
      setLoading(false)
    }
  }

  const handleImageFile = async (file) => {
    if (!file || !file.type || !file.type.startsWith('image/')) return
    try {
      const dataUrl = await fileToWebp(file)
      if (dataUrl) {
        setCustomFile(file)
        setCustomImage(dataUrl)
        setOpen(true)
      }
    } catch {}
  }

  const onCardPaste = (e) => {
    const files = e.clipboardData?.files
    if (files && files.length > 0) {
      for (const f of files) {
        if (f.type && f.type.startsWith('image/')) {
          e.preventDefault()
          e.stopPropagation()
          handleImageFile(f)
          return
        }
      }
    }
    const text = e.clipboardData?.getData('text')
    if (text && /^https?:\/\//i.test(text.trim())) {
      setUrlInput(text.trim())
      handleFetch(text.trim())
    }
  }

  const reset = () => {
    setOpen(false)
    setUrlInput('')
    setLoading(false)
    setPreview(null)
    setCustomImage(null)
    setCustomFile(null)
    setTitle('')
    setNote('')
    setDragOverDropzone(false)
  }

  const handleSubmit = async () => {
    const effectiveImage = customImage || preview?.image
    const effectiveUrl = (preview?.url || urlInput || '').trim()
    if (!effectiveImage && !effectiveUrl) {
      notify({ kind: 'error', label, title: 'Données manquantes', body: 'Ajoute au moins une image ou un lien.' })
      return
    }
    setSubmitting(true)
    try {
      const ok = await onAddReference({
        title: title.trim() || preview?.title || 'Référence',
        url: effectiveUrl,
        note: note.trim() || '',
        file: customFile,
        dataUrl: customImage,
        imageUrl: !customImage ? preview?.image : null,
      })
      if (ok) reset()
    } finally {
      setSubmitting(false)
    }
  }

  const displayedImg = customImage || preview?.image || null

  return (
    <div style={{ marginBottom: 14 }}>
      {!open ? (
        <div style={{
          display: 'flex', alignItems: 'center', gap: 8, padding: '6px 12px', borderRadius: 8,
          background: 'rgba(128,128,128,.08)', border: '1px solid rgba(128,128,128,.16)',
          transition: 'border-color .15s ease',
        }}>
          <Icon name="link" size={14} color={t.textSecondary} />
          <input
            value={urlInput}
            onChange={(e) => setUrlInput(e.target.value)}
            onKeyDown={(e) => {
              if (e.key === 'Enter') {
                e.preventDefault()
                handleFetch(urlInput)
              }
            }}
            onPaste={(e) => {
              const files = e.clipboardData?.files
              if (files && files.length > 0) {
                for (const f of files) {
                  if (f.type && f.type.startsWith('image/')) {
                    e.preventDefault()
                    handleImageFile(f)
                    return
                  }
                }
              }
              const text = e.clipboardData?.getData('text')
              if (text && /^https?:\/\//i.test(text.trim())) {
                setTimeout(() => handleFetch(text.trim()), 10)
              }
            }}
            placeholder="Ajouter une référence : colle un lien (ArtStation, YouTube, web…) ou colle (⌘V) une image…"
            style={{
              flex: 1, background: 'transparent', border: 'none', outline: 'none',
              color: t.textPrimary, font: '400 13px var(--zr-police-sans)',
            }}
          />
          <button
            type="button"
            onClick={() => handleFetch(urlInput)}
            disabled={loading || !urlInput.trim()}
            style={{
              padding: '4px 12px', borderRadius: 6, border: 0,
              background: urlInput.trim() ? (t.accent || '#0a84ff') : 'rgba(128,128,128,.14)',
              color: urlInput.trim() ? '#fff' : t.textSecondary,
              font: '500 12px var(--zr-police-sans)', cursor: urlInput.trim() ? 'pointer' : 'default',
              display: 'inline-flex', alignItems: 'center', gap: 5,
            }}>
            {loading ? 'Recherche…' : 'Aperçu'}
          </button>
        </div>
      ) : (
        <div
          onPaste={onCardPaste}
          onKeyDown={(e) => {
            if (e.key === 'Escape') reset()
            if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
              e.preventDefault()
              handleSubmit()
            }
          }}
          style={{
            padding: 14, borderRadius: 10,
            background: t.surface || 'rgba(255,255,255,.05)',
            border: '1px solid rgba(128,128,128,.25)',
            boxShadow: '0 8px 24px -6px rgba(0,0,0,.35)',
            display: 'flex', flexDirection: 'column', gap: 12,
          }}>
          {/* Ligne URL source + actualiser + fermer */}
          <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
            <Icon name="link" size={14} color={t.textSecondary} />
            <input
              value={urlInput}
              onChange={(e) => setUrlInput(e.target.value)}
              onKeyDown={(e) => { if (e.key === 'Enter') handleFetch(urlInput) }}
              placeholder="https://..."
              style={{
                flex: 1, padding: '6px 10px', borderRadius: 6,
                background: 'rgba(128,128,128,.10)', border: '1px solid rgba(128,128,128,.20)',
                color: t.textPrimary, font: '400 12px var(--zr-police-sans)', outline: 'none',
              }}
            />
            <button
              type="button"
              onClick={() => handleFetch(urlInput)}
              disabled={loading}
              style={{
                padding: '6px 12px', borderRadius: 6, border: 0,
                background: 'rgba(128,128,128,.16)', color: t.textPrimary,
                font: '500 12px var(--zr-police-sans)', cursor: 'pointer',
              }}>
              {loading ? 'Recherche…' : 'Actualiser'}
            </button>
            <button
              type="button"
              onClick={reset}
              title="Fermer"
              style={{
                width: 28, height: 28, borderRadius: 999, border: 0,
                background: 'rgba(128,128,128,.16)', color: t.textSecondary,
                display: 'grid', placeItems: 'center', cursor: 'pointer',
              }}>
              <Icon name="xmark" size={12} color={t.textSecondary} />
            </button>
          </div>

          {/* Grille 2 colonnes : miniature / dépôt à gauche + métadonnées à droite */}
          <div style={{ display: 'grid', gridTemplateColumns: 'minmax(180px, 260px) 1fr', gap: 14 }}>
            {/* Colonne miniature / dépôt */}
            <div
              onClick={() => fileInputRef.current?.click()}
              onDragOver={(e) => { e.preventDefault(); setDragOverDropzone(true) }}
              onDragLeave={() => setDragOverDropzone(false)}
              onDrop={(e) => {
                e.preventDefault(); setDragOverDropzone(false)
                if (e.dataTransfer.files && e.dataTransfer.files[0]) handleImageFile(e.dataTransfer.files[0])
              }}
              style={{
                width: '100%', minHeight: 160, borderRadius: 8, overflow: 'hidden',
                position: 'relative', cursor: 'pointer',
                background: 'rgba(128,128,128,.08)',
                border: dragOverDropzone ? '2px dashed #0a84ff' : (displayedImg ? '1px solid rgba(128,128,128,.25)' : '2px dashed rgba(128,128,128,.3)'),
                display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center',
                transition: 'border-color .15s ease',
              }}>
              {displayedImg ? (
                <>
                  <img src={displayedImg} alt="" style={{ width: '100%', height: '100%', maxHeight: 200, objectFit: 'cover', display: 'block' }} />
                  <div style={{
                    position: 'absolute', inset: 0, background: 'rgba(0,0,0,.55)',
                    opacity: 0, transition: 'opacity .15s ease',
                    display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 4,
                    color: '#fff', font: '500 11px var(--zr-police-sans)', textAlign: 'center', padding: 8,
                  }}
                  onMouseEnter={(e) => { e.currentTarget.style.opacity = '1' }}
                  onMouseLeave={(e) => { e.currentTarget.style.opacity = '0' }}>
                    <Icon name="photo" size={18} color="#fff" />
                    <span>Cliquer ou glisser pour remplacer</span>
                    <span style={{ fontSize: 10, opacity: .8 }}>Coller (⌘V) marche aussi</span>
                  </div>
                </>
              ) : (
                <div style={{ padding: 16, textAlign: 'center', color: t.textSecondary }}>
                  <Icon name="photo" size={28} color={t.textSecondary} />
                  <div style={{ margin: '8px 0 2px', font: '500 12px var(--zr-police-sans)', color: t.textPrimary }}>
                    Coller (⌘V) ou glisser l’image
                  </div>
                  <div style={{ font: '400 11px/1.3 var(--zr-police-sans)', opacity: .7 }}>
                    depuis ArtStation, capture ou fichier
                  </div>
                </div>
              )}
              <input ref={fileInputRef} type="file" accept="image/*" style={{ display: 'none' }}
                onChange={(e) => { if (e.target.files && e.target.files[0]) handleImageFile(e.target.files[0]) }} />
            </div>

            {/* Colonne droite : Titre, lien, note */}
            <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
              {preview?.siteName && (
                <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
                  <span style={{
                    padding: '2px 8px', borderRadius: 4, background: 'rgba(10,132,255,.16)',
                    color: '#0a84ff', font: '500 11px var(--zr-police-sans)',
                  }}>
                    {preview.siteName}
                  </span>
                  {preview.url && (
                    <a href={preview.url} target="_blank" rel="noopener noreferrer" style={{
                      display: 'inline-flex', alignItems: 'center', gap: 3,
                      color: t.textSecondary, textDecoration: 'none', font: '400 11px var(--zr-police-sans)',
                    }}>
                      <span>{(() => { try { return new URL(preview.url).hostname } catch { return '' } })()}</span>
                      <Icon name="arrow.up.right" size={9} color={t.textSecondary} />
                    </a>
                  )}
                </div>
              )}
              <input
                value={title}
                onChange={(e) => setTitle(e.target.value)}
                placeholder="Titre de la référence (ex. Pampas Grass Pond)"
                style={{
                  width: '100%', boxSizing: 'border-box', padding: '7px 10px', borderRadius: 6,
                  background: 'rgba(128,128,128,.10)', border: '1px solid rgba(128,128,128,.20)',
                  color: t.textPrimary, font: '350 14px var(--zr-police-serif)', outline: 'none',
                }}
              />
              <textarea
                value={note}
                onChange={(e) => setNote(e.target.value)}
                rows={3}
                placeholder="Note / description (artiste, technique, éléments à reproduire…)"
                style={{
                  width: '100%', boxSizing: 'border-box', padding: '7px 10px', borderRadius: 6, resize: 'vertical',
                  background: 'rgba(128,128,128,.10)', border: '1px solid rgba(128,128,128,.20)',
                  color: t.textPrimary, font: '400 12px/1.4 var(--zr-police-sans)', outline: 'none',
                }}
              />
              {/* Ligne inférieure : Statut + actions */}
              <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginTop: 'auto', paddingTop: 6 }}>
                <span style={{ font: '400 11px var(--zr-police-sans)', color: displayedImg ? t.textSecondary : '#ff9f0a' }}>
                  {displayedImg ? 'Miniature prête' : '⚠️ Colle (⌘V) ou glisse une image pour compléter'}
                </span>
                <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                  <button
                    type="button"
                    onClick={reset}
                    style={{
                      padding: '6px 12px', borderRadius: 6, border: 0,
                      background: 'transparent', color: t.textSecondary,
                      font: '400 12px var(--zr-police-sans)', cursor: 'pointer',
                    }}>
                    Annuler
                  </button>
                  <button
                    type="button"
                    onClick={handleSubmit}
                    disabled={submitting || (!displayedImg && !urlInput.trim())}
                    style={{
                      padding: '6px 14px', borderRadius: 6, border: 0,
                      background: '#0a84ff', color: '#fff',
                      font: '500 12px var(--zr-police-sans)',
                      cursor: submitting || (!displayedImg && !urlInput.trim()) ? 'default' : 'pointer',
                      opacity: submitting || (!displayedImg && !urlInput.trim()) ? .5 : 1,
                      display: 'inline-flex', alignItems: 'center', gap: 5,
                      boxShadow: '0 1px 4px rgba(10,132,255,.3)',
                    }}>
                    {submitting ? 'Ajout en cours…' : `Ajouter à ${label}`}
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}

export default function GalleryView({ t, galleryKey }) {
  const gallery = galleryByKey(galleryKey)
  const label = gallery ? gallery.label : galleryKey
  const path = gallery && gallery.path
  const changeEvent = `zr:gallery-changed:${galleryKey}`
  const otherGalleries = POINTER_GALLERIES.filter((g) => g.key !== galleryKey)

  const [data, setData] = React.useState(null)
  const [section, setSection] = React.useState('active')
  const [ouvert, setOuvert] = React.useState(null) // item en lightbox, ou null
  const [folderId, setFolderId] = React.useState(null) // dossier ouvert, ou null = racine
  const [renamingId, setRenamingId] = React.useState(null)
  const [overId, setOverId] = React.useState(null) // survol drag (surbrillance de la cible)
  const [dragOverGrid, setDragOverGrid] = React.useState(false) // fichier Finder survolant la grille
  const [uploading, setUploading] = React.useState(0) // compte en cours, 0 = rien
  const [menu, setMenu] = React.useState(null) // { x, y, it } | null
  // DISPOSITION (2026-08-21). Deux vues du MÊME contenu, jamais deux stockages : « Grille » est la
  // planche Explore d'origine, « Alignées » est la table lumineuse — tuiles au même gabarit, remises
  // en ordre à la main. Le mode vit en local (localStorage), par galerie : c'est une préférence de
  // regard, pas une donnée du drive, et l'écrire sur GitHub ferait un commit par clic de bouton.
  const [layout, setLayout] = React.useState(() => {
    try {
      const saved = localStorage.getItem(`zr:gallery:layout:${galleryKey}`)
      // 2026-09-10: ToDo-3D is an action board, so grouping must be its first visible gesture.
      return saved === 'aligned' ? 'aligned' : 'grid'
    } catch { return 'grid' }
  })
  React.useEffect(() => { try { localStorage.setItem(`zr:gallery:layout:${galleryKey}`, layout) } catch {} }, [layout, galleryKey])
  const [insert, setInsert] = React.useState(null) // { id, side } — barre d'insertion du mode aligné
  const shaRef = React.useRef(null)

  React.useEffect(() => {
    if (!path) return undefined
    let vivant = true
    readJson(path).then(({ data: lu, sha }) => {
      if (!vivant) return
      shaRef.current = sha
      setData(lu && typeof lu === 'object' ? lu : { v: 1, items: [] })
    }).catch(() => { if (vivant) setData({ v: 1, items: [] }) })
    return () => { vivant = false }
  }, [path])

  // Même convention événementielle que Goals (`zr:goals-changed`) : un ajout posé ailleurs (clic
  // droit dans Create) doit apparaître ici sans recharger la page. Un canal PAR galerie (suffixe
  // `galleryKey`) : un ajout à Characters ne doit jamais déclencher un rechargement sur Environments.
  React.useEffect(() => {
    if (!path) return undefined
    const surAjout = () => {
      readJson(path).then(({ data: lu, sha }) => { shaRef.current = sha; if (lu) setData(lu) }).catch(() => {})
    }
    window.addEventListener(changeEvent, surAjout)
    return () => window.removeEventListener(changeEvent, surAjout)
  }, [path, changeEvent])

  const rootItems = data?.items || []
  const currentFolder = folderId ? rootItems.find((it) => it.id === folderId && it.kind === 'folder') : null
  // Le dossier ouvert a pu être retiré ailleurs (autre onglet, sync) : on revient à la racine plutôt
  // que d'afficher une vue fantôme sur un id qui n'existe plus.
  React.useEffect(() => { if (folderId && data && !currentFolder) setFolderId(null) }, [folderId, data, currentFolder])
  // 5 October 2026, 12:32 CEST: Completion belongs to the root project, preserving its references.
  const hasDoneSection = galleryKey === 'todo3d'
  const visibleRootItems = hasDoneSection ? rootItems.filter((item) => (item.status === 'done') === (section === 'done')) : rootItems
  const items = currentFolder ? (currentFolder.items || []) : visibleRootItems

  // UN SEUL POINT DE PASSAGE pour toute mutation du niveau AFFICHÉ (racine, ou le tableau `items` d'un
  // dossier ouvert) : jamais deux endroits qui doivent se souvenir séparément « suis-je dans un
  // dossier ». Utilisé aussi bien pour l'état optimiste local que pour le retry anti-conflit.
  const mutateLevel = (cur, f) => {
    const root = (cur && cur.items) || []
    if (!folderId) return { ...(cur || {}), v: 1, items: f(root) }
    return { ...(cur || {}), v: 1, items: root.map((it) => (it.id === folderId && it.kind === 'folder') ? { ...it, items: f(it.items || []) } : it) }
  }
  const ecrire = async (f, erreurTitre) => {
    const next = mutateLevel(data, f)
    setData(next)
    const res = await saveJsonWithRetry(path, (cur) => mutateLevel(cur, f), { sha: shaRef.current, data })
    if (res.ok) shaRef.current = res.sha
    else notify({ kind: 'error', label, title: erreurTitre, body: 'Réessaie, un conflit a empêché l’écriture.' })
    return res.ok
  }
  // Rename opère sur le dossier LUI-MÊME, qui vit toujours à la racine (jamais de dossier dans un
  // dossier) — que l'on renomme depuis la grille (dehors) ou depuis le fil d'Ariane (dedans), la
  // cible est la même liste racine, jamais `mutateLevel` (qui viserait le CONTENU du dossier).
  const renommerDossier = async (id, name) => {
    const appliquer = (cur) => ({ ...(cur || {}), v: 1, items: ((cur && cur.items) || []).map((it) => it.id === id ? { ...it, name } : it) })
    setData(appliquer)
    const res = await saveJsonWithRetry(path, appliquer, { sha: shaRef.current, data })
    if (res.ok) shaRef.current = res.sha
  }
  const retirer = (id) => ecrire((list) => list.filter((it) => it.id !== id), 'Retrait non enregistré')

  // TITRE + NOTE. Un dossier vit TOUJOURS à la racine (jamais de dossier dans un dossier), donc il ne
  // se modifie pas par `ecrire`, qui vise le niveau AFFICHÉ — la même asymétrie que `renommerDossier`
  // juste au-dessus, et la raison pour laquelle les deux chemins restent séparés.
  const enregistrerTexte = async (it, { name, url, note }) => {
    setRenamingId(null)
    // Groupe : le champ saisi EST son nom. Image : c'est un titre facultatif, posé à côté du `name`
    // technique, qu'on ne touche jamais — il sert au partage, au menu et au nom de fichier exporté.
    const champs = it.kind === 'folder' ? { name: name || '', note: note || '' } : { title: name || '', url: url || '', note: note || '' }
    if (it.kind === 'folder') {
      const appliquer = (cur) => ({ ...(cur || {}), v: 1, items: ((cur && cur.items) || []).map((x) => x.id === it.id ? { ...x, ...champs } : x) })
      setData(appliquer)
      const res = await saveJsonWithRetry(path, appliquer, { sha: shaRef.current, data })
      if (res.ok) shaRef.current = res.sha
      else notify({ kind: 'error', label, title: 'Texte non enregistré', body: 'Réessaie, un conflit a empêché l’écriture.' })
      return
    }
    await ecrire((list) => list.map((x) => x.id === it.id ? { ...x, ...champs } : x), 'Texte non enregistré')
  }

  // ── REMISE EN ORDRE À LA MAIN (2026-08-21) ────────────────────────────────────────────────────────
  // Mécanique reprise TELLE QUELLE du Shelf (src/components/Shelf.jsx, `dragApi.dropOn` et `sideOf`),
  // qui la porte depuis des mois et qui marche : on retire l'élément de la liste, puis on le réinsère
  // AVANT ou APRÈS la cible selon la moitié survolée. Retirer d'abord et chercher l'index ensuite
  // n'est pas un détail de style : chercher l'index avant le retrait décale l'insertion d'un cran dès
  // qu'on déplace un élément vers la droite, et le bug ne se voit que dans ce sens-là.
  //
  // POURQUOI UN MODE ET PAS UN GESTE DE PLUS. Dans la grille, lâcher une image sur une autre CRÉE UN
  // GROUPE. Le même geste ne peut pas vouloir dire deux choses ; c'est la disposition qui tranche, et
  // le mode est visible à l'écran, donc le geste n'est jamais ambigu.
  const reordonner = async (fromId, targetId, after) => {
    setInsert(null)
    if (!fromId || fromId === targetId) return
    await ecrire((list) => {
      const a = [...list]
      const fi = a.findIndex((x) => x.id === fromId)
      if (fi < 0) return list
      const [deplace] = a.splice(fi, 1)
      const ti = a.findIndex((x) => x.id === targetId)
      if (ti < 0) a.push(deplace); else a.splice(after ? ti + 1 : ti, 0, deplace)
      return a
    }, 'Ordre non enregistré')
  }

  // ── COLLER / GLISSER UN MÉDIA (2026-08-21) ────────────────────────────────────────────────────────
  // Même chemin, prouvé ailleurs dans l'app (Articles, Shelf, Gallery.jsx) : conversion WebP CÔTÉ
  // NAVIGATEUR (quasi instantanée via canvas.toBlob, contrairement à AVIF qui coûte cher à ENCODER),
  // puis `/api/img` — déjà une route API qui écrit directement sur GitHub, jamais le pipeline CLI de
  // l'archiveur ZenRayCloud. Encodage en parallèle par lots de 4 (CPU), envoi en SÉRIE (chaque
  // /api/img = un commit GitHub, sérialiser évite des conflits de commit concurrents).
  async function addFiles(fileList) {
    const imgs = [...fileList].filter((f) => f.type && f.type.startsWith('image/'))
    if (!imgs.length) return
    setUploading((n) => n + imgs.length)
    const added = []
    const ENC = 4
    for (let i = 0; i < imgs.length; i += ENC) {
      const enc = await Promise.all(imgs.slice(i, i + ENC).map(async (f) => {
        let w = 4, h = 3
        try { const bmp = await createImageBitmap(f); w = bmp.width; h = bmp.height } catch {}
        const webp = await fileToWebp(f).catch(() => null)
        return webp ? { webp, w, h, name: f.name } : null
      }))
      for (const e of enc) {
        if (!e) continue
        const j = await fetch('/api/img', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ dataUrl: e.webp, dir: 'uploads' }) }).then((r) => r.json()).catch(() => null)
        if (j && j.path) added.push({ id: `g-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`, kind: 'image', path: j.path, name: e.name, w: e.w, h: e.h, addedAt: new Date().toISOString() })
      }
    }
    setUploading((n) => Math.max(0, n - imgs.length))
    if (!added.length) return
    await ecrire((list) => [...list, ...added], 'Import non enregistré')
  }

  // AJOUT D'UNE RÉFÉRENCE VIA LIEN OU COLLAGE MANUEL (02 October 2026, demande de Matthieu)
  // Reçoit les données de GalleryLinkBox (titre, URL source, note, fichier ou dataUrl ou URL distante).
  // Si une image est fournie en fichier ou dataUrl, elle est convertie en WebP puis déposée via /api/img.
  // Si seule une URL distante d'image est fournie (ex. YouTube oEmbed), /api/img la télécharge côté serveur.
  // En cas de blocage ou d'échec de téléchargement distant, l'URL de l'image sert directement de secours.
  const ajouterReference = async ({ title, url, note, file, dataUrl, imageUrl }) => {
    setUploading((n) => n + 1)
    try {
      let finalPath = ''
      let w = 16, h = 9
      if (file) {
        try { const bmp = await createImageBitmap(file); w = bmp.width; h = bmp.height } catch {}
        const webp = await fileToWebp(file).catch(() => null)
        if (webp) {
          const j = await fetch('/api/img', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ dataUrl: webp, dir: 'uploads' }) }).then((r) => r.json()).catch(() => null)
          if (j && j.path) finalPath = j.path
        }
      } else if (dataUrl) {
        try {
          const img = new Image()
          img.src = dataUrl
          await img.decode()
          w = img.naturalWidth || 16
          h = img.naturalHeight || 9
        } catch {}
        const j = await fetch('/api/img', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ dataUrl, dir: 'uploads' }) }).then((r) => r.json()).catch(() => null)
        if (j && j.path) finalPath = j.path
      } else if (imageUrl) {
        const j = await fetch('/api/img', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url: imageUrl, dir: 'uploads' }) }).then((r) => r.json()).catch(() => null)
        if (j && j.path) {
          finalPath = j.path
        } else {
          finalPath = imageUrl
        }
      }

      const item = {
        id: `g-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`,
        kind: 'image',
        path: finalPath,
        name: title || 'Référence',
        title: title || '',
        url: url || '',
        note: note || '',
        w,
        h,
        addedAt: new Date().toISOString(),
      }

      const ok = await ecrire((list) => [item, ...list], 'Référence non enregistrée')
      if (ok) {
        notify({ kind: 'success', label, title: 'Référence ajoutée', body: title || url || 'Nouvelle référence enregistrée' })
      }
      return ok
    } catch (err) {
      notify({ kind: 'error', label, title: 'Erreur ajout référence', body: String(err?.message || err) })
      return false
    } finally {
      setUploading((n) => Math.max(0, n - 1))
    }
  }

  useClipboardTarget('gallery:' + galleryKey, { onPasteImage: (files) => addFiles(files) }, true)
  const onGridDragOver = (e) => { if (![...e.dataTransfer.types].includes('Files')) return; e.preventDefault(); setDragOverGrid(true) }
  const onGridDragLeave = () => setDragOverGrid(false)
  const onGridDrop = (e) => {
    if (!e.dataTransfer.files || !e.dataTransfer.files.length) return
    e.preventDefault(); setDragOverGrid(false)
    addFiles(e.dataTransfer.files)
  }

  // ── GROUPES PAR GLISSER-DÉPOSER (2026-08-21) ──────────────────────────────────────────────────────
  // Un seul niveau, jamais de dossier dans un dossier — la même règle qu'iOS. Glisser une image sur
  // une AUTRE image crée un groupe ; glisser une image sur un groupe l'y ajoute ; un DOSSIER glissé ne
  // s'imbrique jamais nulle part (on l'ignore silencieusement, comme iOS refuse un dossier dans un
  // dossier sans le dire non plus).
  const DND_TYPE = 'application/zenray-gallery-item'
  const onItemDragStart = (it) => (e) => { e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData(DND_TYPE, it.id) }
  const onItemDragOver = (it) => (e) => {
    if (![...e.dataTransfer.types].includes(DND_TYPE)) return // laisse filer un glisser Finder externe
    e.preventDefault(); e.stopPropagation(); setOverId(it.id)
  }
  const onItemDragLeave = (it) => () => setOverId((o) => (o === it.id ? null : o))
  const onItemDrop = (target) => async (e) => {
    const draggedId = e.dataTransfer.getData(DND_TYPE)
    setOverId(null)
    if (!draggedId || draggedId === target.id) return
    e.preventDefault(); e.stopPropagation()
    const dragged = items.find((x) => x.id === draggedId)
    if (!dragged || dragged.kind === 'folder') return
    let nouveauId = null
    const f = target.kind === 'folder'
      ? (list) => list.filter((x) => x.id !== draggedId).map((x) => x.id === target.id ? { ...x, items: [...(x.items || []), dragged] } : x)
      : (list) => {
        nouveauId = `f-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`
        return list.filter((x) => x.id !== draggedId).map((x) => x.id === target.id
          ? { id: nouveauId, kind: 'folder', name: 'Nouveau groupe', items: [x, dragged], addedAt: new Date().toISOString() }
          : x)
      }
    const ok = await ecrire(f, 'Regroupement non enregistré')
    if (ok && nouveauId) setRenamingId(nouveauId) // le nom se propose tout de suite, prêt à taper
  }

  // ── DÉPLACER VERS… (menu, alternative au glisser) ─────────────────────────────────────────────────
  const rootFolders = rootItems.filter((x) => x.kind === 'folder')
  const deplacerVers = async (it, targetFolderId) => {
    if (it.kind === 'folder') return
    const appliquer = (cur) => {
      const root = (cur && cur.items) || []
      const source = folderId
        ? root.map((x) => x.id === folderId ? { ...x, items: (x.items || []).filter((y) => y.id !== it.id) } : x)
        : root.filter((x) => x.id !== it.id)
      if (targetFolderId === null) return { ...(cur || {}), v: 1, items: folderId ? [...source, it] : source }
      return { ...(cur || {}), v: 1, items: source.map((x) => x.id === targetFolderId ? { ...x, items: [...(x.items || []), it] } : x) }
    }
    setData(appliquer)
    const res = await saveJsonWithRetry(path, appliquer, { sha: shaRef.current, data })
    if (res.ok) shaRef.current = res.sha
    else notify({ kind: 'error', label, title: 'Déplacement non enregistré', body: 'Réessaie, un conflit a empêché l’écriture.' })
  }

  // ── COPIER / COUPER / PARTAGER (2026-08-21) ───────────────────────────────────────────────────────
  const blobOfItem = async (it) => {
    const url = isRawUpload(it.path) ? rawUrl(it.path) : await (async () => {
      const m = await readImgManifestCached(it.path)
      return m ? await resolveFullUrl(m) : null
    })()
    if (!url) return null
    return fetch(url).then((r) => (r.ok ? r.blob() : null)).catch(() => null)
  }
  const copier = async (it) => {
    const blob = await blobOfItem(it)
    if (!blob) return notify({ kind: 'error', label, title: 'Copie impossible', body: 'Image introuvable.' })
    try {
      await navigator.clipboard.write([new ClipboardItem({ [blob.type || 'image/webp']: blob })])
      notify({ kind: 'info', label, title: 'Copié', body: it.name || 'Image copiée dans le presse-papiers.' })
    } catch { notify({ kind: 'error', label, title: 'Copie impossible', body: 'Le navigateur a refusé l’accès au presse-papiers.' }) }
  }
  const couper = async (it) => { await copier(it); retirer(it.id) }
  const partager = async (it) => {
    const blob = await blobOfItem(it)
    if (!blob) return notify({ kind: 'error', label, title: 'Partage impossible', body: 'Image introuvable.' })
    const file = new File([blob], (it.name || 'image').replace(/\.[a-z0-9]+$/i, '') + '.' + (blob.type.split('/')[1] || 'webp'), { type: blob.type })
    if (navigator.canShare && navigator.canShare({ files: [file] })) {
      try { await navigator.share({ files: [file], title: it.name || label }); return } catch { return } // annulé : pas d'erreur à montrer
    }
    // Repli desktop : seul un chemin uploads/ (posé par /api/img) a un lien PUBLIC stable. Un
    // manifeste Create est chiffré au repos — rien à lier, seule l'image elle-même se partage.
    if (isRawUpload(it.path)) {
      const shareUrl = `${location.origin}${rawUrl(it.path)}`
      try { await navigator.clipboard.writeText(shareUrl); notify({ kind: 'info', label, title: 'Lien copié', body: shareUrl }) }
      catch { notify({ kind: 'error', label, title: 'Partage impossible', body: 'Copie du lien refusée.' }) }
      return
    }
    await copier(it)
    notify({ kind: 'info', label, title: 'Copié (partage indisponible)', body: 'Colle l’image où tu veux la partager.' })
  }

  // ── PONT VERS CREATE (2026-08-21) ─────────────────────────────────────────────────────────────────
  // GalleryView est un module séparé (lazy-chargé) sans accès aux fermetures d'App.jsx. Plutôt que
  // dupliquer `trashPath` (move + sidecar + retry) ou `runCapture` (tout le pipeline d'ingestion), on
  // les rappelle via un événement écouté là-bas — même geste que `zr:open-page`. `resolve` rend
  // l'appel attendable sans construire un vrai bus RPC ; un filet de 8 s évite de rester bloqué si
  // personne n'écoute.
  const dispatchAndWait = (name, detail) => new Promise((resolve) => {
    window.dispatchEvent(new CustomEvent(name, { detail: { ...detail, resolve } }))
    setTimeout(() => resolve(false), 8000)
  })
  const envoyerVersCreate = async (it) => {
    const blob = await blobOfItem(it)
    if (!blob) return notify({ kind: 'error', label, title: 'Envoi impossible', body: 'Image introuvable.' })
    const file = new File([blob], (it.name || 'image').replace(/\.[a-z0-9]+$/i, '') + '.' + (blob.type.split('/')[1] || 'webp'), { type: blob.type })
    const ok = await dispatchAndWait('zr:gallery-send-to-create', { file })
    if (ok) { retirer(it.id); notify({ label, title: 'Envoyé dans Create', body: it.name || '' }) }
    else notify({ kind: 'error', label, title: 'Envoi échoué', body: 'Create n’a pas confirmé la réception.' })
  }
  const supprimerDeCreate = async (it) => {
    if (!window.confirm(`Supprimer « ${it.name || 'cette image'} » de Create ? Elle ira dans Trash, récupérable.`)) return
    const ok = await dispatchAndWait('zr:gallery-delete-from-create', { path: it.path })
    if (ok) retirer(it.id)
  }

  // ── MENU CLIC DROIT (2026-08-21, demande Matthieu : l'ancien bouton « × » au survol était une seule
  // option sans nom ni contexte — « pas logique »). Chaque action se montre ou se désactive selon ce
  // qui a RÉELLEMENT un sens pour cet item précis, plutôt que d'exposer huit boutons dont la moitié ne
  // font rien : un dossier ne se copie pas, un item posé par collage n'est « dans Create » nulle part
  // à en retirer, un item déjà brut n'a rien à y envoyer une seconde fois.
  const menuNodesFor = (it) => {
    const isFolder = it.kind === 'folder'
    const raw = !isFolder && isRawUpload(it.path)
    const cibles = []
    if (folderId) cibles.push({ id: 'to-root', label: `${label} (racine)`, icon: <Icon name="chevron.left" size={14} />, action: () => deplacerVers(it, null) })
    for (const f of rootFolders) {
      if (folderId === f.id) continue
      if (!folderId && f.id === it.id) continue
      cibles.push({ id: `to-${f.id}`, label: f.name, icon: <Icon name="folder" size={14} />, action: () => deplacerVers(it, f.id) })
    }
    return [
      { id: 'open', label: isFolder ? 'Ouvrir' : 'Ouvrir en plein écran', icon: <Icon name="arrow.up.right" size={14} />, action: () => (isFolder ? setFolderId(it.id) : setOuvert(it)) },
      it.url && { id: 'source', label: 'Ouvrir la source web', icon: <Icon name="arrow.up.right" size={14} />, action: () => window.open(it.url, '_blank', 'noopener,noreferrer') },
      hasDoneSection && !folderId && { id: 'completion', label: it.status === 'done' ? 'Remettre en cours' : 'Ranger dans Done', icon: <Icon name="checkmark" size={14} />, action: () => ecrire((list) => list.map((item) => item.id === it.id ? { ...item, status: it.status === 'done' ? 'active' : 'done' } : item), 'Statut non enregistré') },
      { id: 'text', label: 'Titre et note…', icon: <Icon name="doc.text" size={14} />, action: () => setRenamingId(it.id) },
      { id: 'move', label: 'Déplacer vers…', icon: <Icon name="folder" size={14} />, disabled: isFolder || !cibles.length, children: isFolder ? [] : cibles },
      !isFolder && { id: 'copy', label: 'Copier', icon: <Icon name="doc.text" size={14} />, action: () => copier(it) },
      !isFolder && { id: 'cut', label: 'Couper', icon: <Icon name="scissors" size={14} />, action: () => couper(it) },
      !isFolder && { id: 'share', label: 'Partager…', icon: <Icon name="arrow.up.right" size={14} />, action: () => partager(it) },
      { id: 'add-to', label: 'Ajouter à…', icon: <Icon name="photo" size={14} />, disabled: isFolder, children: isFolder ? [] : otherGalleries.map((g) => ({
        id: `add-${g.key}`, label: g.label, action: () => ajouterAGalerie(g.key, [{ kind: it.kind, path: it.path, name: it.name, w: it.w, h: it.h }]),
      })) },
      !isFolder && { id: 'to-create', label: 'Déplacer dans Create', icon: <Icon name="arrow.up.right" size={14} />, disabled: !raw, action: () => envoyerVersCreate(it) },
      { id: 'remove', label: `Retirer de ${label}`, icon: <Icon name="xmark" size={14} />, action: () => retirer(it.id) },
      !isFolder && { id: 'delete-create', label: 'Supprimer de Create', icon: <Icon name="trash" size={14} />, danger: true, disabled: raw, action: () => supprimerDeCreate(it) },
    ].filter(Boolean)
  }

  // ── UNE SEULE DÉFINITION DE TUILE, DEUX JEUX DE PARAMÈTRES (2026-08-21) ───────────────────────────
  // Loi HDA appliquée au rendu : la grille et la table lumineuse ne diffèrent que par trois valeurs —
  // le format de la tuile, la largeur qu'elle occupe, et ce que veut dire un lâcher dessus. Dupliquer
  // le rendu pour ces trois-là aurait donné deux tuiles qui divergent dès le premier champ ajouté.
  const rendreTuile = (it, aligne) => {
    // 16:9 OU PROCHE, DONC 2 CASES en grille : une image horizontale écrasée dans une seule case
    // devient trop petite. Seuil large (1,3) plutôt que 16:9 exact (1,78), pour capter le « proche »
    // sans mordre sur le quasi-carré. En mode aligné, toutes les tuiles partagent le MÊME gabarit :
    // c'est exactement ce qu'on demande à une table lumineuse, comparer des images entre elles.
    const large = !aligne && it.kind === 'image' && it.w && it.h && it.w / it.h >= 1.3
    const ratio = aligne ? '4 / 3' : (it.w && it.h ? `${it.w} / ${it.h}` : '4 / 5')
    const surLigne = insert && insert.id === it.id ? insert.side : null
    const editing = renamingId === it.id
    const ouvrirEditeur = () => setRenamingId(it.id)
    // 3 October 2026 10:36: Center groups items; aligned tile edges retain reordering.
    const dropSide = (e) => {
      const bounds = e.currentTarget.getBoundingClientRect()
      const position = (e.clientX - bounds.left) / bounds.width
      const edgeFraction = 0.25
      return position < edgeFraction ? 'left' : position > 1 - edgeFraction ? 'right' : null
    }
    const dragProps = {
      draggable: true,
      onDragStart: onItemDragStart(it),
      onDragEnd: () => { setInsert(null); setOverId(null) },
      onDragOver: (e) => {
        if (![...e.dataTransfer.types].includes(DND_TYPE)) return
        const side = aligne ? dropSide(e) : null
        setInsert(side ? { id: it.id, side } : null)
        if (side) { e.preventDefault(); e.stopPropagation(); setOverId(null) }
        else onItemDragOver(it)(e)
      },
      onDragLeave: () => { setInsert((v) => v?.id === it.id ? null : v); onItemDragLeave(it)() },
      onDrop: (e) => {
        const side = aligne ? dropSide(e) : null
        setInsert(null)
        if (!side) return onItemDrop(it)(e)
        const from = e.dataTransfer.getData(DND_TYPE)
        if (!from) return
        e.preventDefault(); e.stopPropagation(); setOverId(null)
        return reordonner(from, it.id, side === 'right')
      },
      onContextMenu: (e) => { e.preventDefault(); e.stopPropagation(); setMenu({ x: e.clientX, y: e.clientY, it }) },
      style: overId === it.id ? { outline: '2px solid #0a84ff', outlineOffset: 2, borderRadius: 4 } : undefined,
    }
    return (
      <div key={it.id} className="zr-tap" style={{ position: 'relative', gridColumn: large ? 'span 2' : undefined }}>
        {/* Barre d'insertion lumineuse, reprise du Shelf : elle montre OÙ la tuile va se poser avant
            qu'on lâche. Décalée de 5 px dans la gouttière de 10 px, donc centrée entre deux tuiles. */}
        {surLigne && <span aria-hidden style={{ position: 'absolute', top: 0, bottom: 0, [surLigne]: -5, width: 4, borderRadius: 4, background: t.accent, boxShadow: `0 0 12px 1px ${t.accent}`, zIndex: 6 }} />}
        {it.kind === 'image' ? (
          <div {...dragProps}
            style={{ width: '100%', aspectRatio: ratio, position: 'relative', borderRadius: 4, overflow: 'hidden', cursor: editing ? 'default' : 'zoom-in', ...(dragProps.style || {}) }}
            onClick={() => { if (!editing) setOuvert(it) }}>
            <GalleryThumb path={it.path} alt={it.name} style={{ width: '100%', height: '100%', objectFit: 'cover', display: 'block' }} />
            <TileCaption title={it.title} note={it.note} url={it.url} onEdit={ouvrirEditeur} />
            {editing ? <TileEditor item={it} onSave={(v) => enregistrerTexte(it, v)} onCancel={() => setRenamingId(null)} /> : null}
          </div>
        ) : (
          <FolderTile folder={it} ratio={aligne ? '4 / 3' : '4 / 5'} editing={editing}
            onOpen={() => { if (!editing) setFolderId(it.id) }}
            onEdit={ouvrirEditeur}
            onSave={(v) => enregistrerTexte(it, v)}
            onCancel={() => setRenamingId(null)}
            dragProps={dragProps} />
        )}
        <button type="button" className="zr-gallery-remove" title={`Retirer de ${label}`} aria-label={`Retirer de ${label}`}
          onClick={(e) => { e.stopPropagation(); retirer(it.id) }}
          style={{
            position: 'absolute', top: 6, right: 6, width: 24, height: 24, borderRadius: 999,
            border: 0, background: 'rgba(0,0,0,.55)', color: '#fff', display: 'grid', placeItems: 'center',
            cursor: 'pointer', opacity: 0, transition: 'opacity .15s ease', zIndex: 4,
          }}
          onMouseEnter={(e) => e.stopPropagation()}>
          <Icon name="xmark" size={11} color="#fff" />
        </button>
      </div>
    )
  }

  return (
    <div style={{ maxWidth: 1400, margin: '0 auto', padding: '4px 0 40px' }}>
      {/* FIL D'ARIANE MINIMAL (2026-08-21). Volontairement PAS le composant `Crumbs` de Create : celui-là
          est profondément couplé à sa propre navigation (colonnes façon Finder, glisser pour déplacer une
          vraie page, historique) pour un chemin qui ne fait jamais que DEUX niveaux ici. Même famille
          typographique que le titre existant pour rester cohérent à l'œil, sans en importer la mécanique.
          Le segment actif EST le champ de renommage : un clic dessus l'édite, exactement comme dans Shelf. */}
      <div style={{ marginBottom: 12, display: 'flex', alignItems: 'center', gap: 6, minHeight: 22 }}>
        {currentFolder ? (
          <>
            <h1 onClick={() => setFolderId(null)} title={`Retour à ${label}`}
              style={{ margin: 0, font: "500 16px/1.3 var(--zr-police-sans)", color: t.textSecondary, cursor: 'pointer' }}>{label}</h1>
            <Icon name="chevron.right" size={11} color={t.textSecondary} />
            {renamingId === currentFolder.id ? (
              <input autoFocus defaultValue={currentFolder.name} title="Renommer"
                onKeyDown={(e) => { if (e.key === 'Enter') e.currentTarget.blur() }}
                onBlur={(e) => { const v = e.target.value.trim(); setRenamingId(null); if (v && v !== currentFolder.name) renommerDossier(currentFolder.id, v) }}
                style={{ font: "500 16px/1.3 var(--zr-police-sans)", color: t.textPrimary, background: 'transparent', border: 'none', borderBottom: `1px solid ${t.textSecondary}`, outline: 'none', padding: 0 }} />
            ) : (
              <h1 onClick={() => setRenamingId(currentFolder.id)} title="Cliquer pour renommer"
                style={{ margin: 0, font: "500 16px/1.3 var(--zr-police-sans)", color: t.textPrimary, cursor: 'text' }}>{currentFolder.name}</h1>
            )}
          </>
        ) : (
          <h1 style={{ margin: 0, font: "500 16px/1.3 var(--zr-police-sans)", color: t.textSecondary }}>{label}</h1>
        )}
        {uploading > 0 && <span style={{ font: "400 12px var(--zr-police-sans)", color: t.textSecondary }}>· import {uploading}…</span>}
        <span style={{ flex: 1 }} />
        {/* BASCULE DE DISPOSITION. Deux segments, pas un menu : il n'y a que deux états et ils se lisent
            en entier, donc les cacher derrière un déclencheur coûterait un clic pour rien. Texte en Inter
            Regular 400, la règle du trio typographique pour tout ce qui est chrome d'interface. */}
        <div role="group" aria-label="Disposition" style={{ display: 'inline-flex', gap: 2, padding: 2, borderRadius: 8, background: 'rgba(128,128,128,.12)' }}>
          {[{ k: 'grid', l: 'Grille · grouper', i: 'square.grid.2x2' }, { k: 'aligned', l: 'Alignées', i: 'square.grid.3x3' }].map((m) => {
            const on = layout === m.k
            return (
              <button key={m.k} type="button" onClick={() => setLayout(m.k)} aria-pressed={on}
                title={m.k === 'grid' ? 'Grille : glisser une image sur une autre forme un groupe' : 'Alignées : déposer au centre pour grouper, sur les bords pour remettre en ordre'}
                style={{
                  display: 'inline-flex', alignItems: 'center', gap: 5, padding: '3px 9px', borderRadius: 6, border: 0, cursor: 'pointer',
                  background: on ? t.surface : 'transparent', color: on ? t.textPrimary : t.textSecondary,
                  font: '400 12px var(--zr-police-sans)', boxShadow: on ? '0 1px 3px rgba(0,0,0,.14)' : 'none',
                }}>
                <Icon name={m.i} size={12} color={on ? t.textPrimary : t.textSecondary} />{m.l}
              </button>
            )
          })}
        </div>
      </div>

      {hasDoneSection && !currentFolder && (
        <div role="group" aria-label="Projets ToDo-3D" style={{ display: 'flex', gap: 6, marginBottom: 12 }}>
          {[{ key: 'active', label: 'En cours' }, { key: 'done', label: 'Done' }].map((tab) => (
            <button key={tab.key} type="button" aria-pressed={section === tab.key} onClick={() => { setSection(tab.key); setRenamingId(null) }}
              style={{ padding: '5px 12px', borderRadius: 8, border: 0, cursor: 'pointer', background: section === tab.key ? t.surface : 'transparent', color: section === tab.key ? t.textPrimary : t.textSecondary, font: '400 12px var(--zr-police-sans)' }}>
              {tab.label}
            </button>
          ))}
        </div>
      )}

      <GalleryLinkBox t={t} label={label} onAddReference={ajouterReference} />

      {layout === 'aligned' && (
        <p style={{ margin: '-5px 0 10px', font: '400 12px/1.4 var(--zr-police-sans)', color: t.textSecondary }}>
          Glisse une image au centre d’une autre pour les grouper, ou sur ses bords pour changer l’ordre.
        </p>
      )}

      <FadeIn key={folderId || 'root'}>
        <div onDragOver={onGridDragOver} onDragLeave={onGridDragLeave} onDrop={onGridDrop}
          style={{ borderRadius: 8, outline: dragOverGrid ? '2px dashed rgba(10,132,255,.6)' : 'none', outlineOffset: 4, transition: 'outline .12s ease' }}>
          {data === null ? (
            <p style={{ font: "400 13px var(--zr-police-sans)", color: t.textSecondary }}>lecture…</p>
          ) : items.length === 0 ? (
            <p style={{ font: "400 13px/1.6 var(--zr-police-sans)", color: t.textSecondary, maxWidth: '60ch' }}>
              {currentFolder
                ? 'Ce groupe est vide. Colle (⌘V) ou glisse une image ici.'
                : hasDoneSection && section === 'done' ? 'Aucun projet terminé. Clic droit sur une carte → Ranger dans Done.'
                : <>Rien pour l’instant. Colle (⌘V) une image, glisse-la depuis le Finder, ou clic droit sur une image dans Create → « Ajouter à {label} ».</>}
            </p>
          ) : (
            // 4 PAR RANGÉE MAXIMUM en grille : une vraie grille, pas un masonry en colonnes CSS
            // (celui-ci équilibre la hauteur des colonnes, jamais 4 par rangée strictement). En aligné,
            // `auto-fill minmax(200px, 1fr)` : le nombre de colonnes suit la largeur réelle de la fenêtre
            // au lieu d'être figé, ce qu'exige une planche de références qu'on regarde en grand.
            <div style={layout === 'aligned'
              ? { display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(200px, 1fr))', gap: 10 }
              : { display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: 3 }}>
              {items.map((it) => rendreTuile(it, layout === 'aligned'))}
            </div>
          )}
        </div>
      </FadeIn>

      {ouvert && <Lightbox item={ouvert} onClose={() => setOuvert(null)} />}
      {menu && (
        <ActionColumnPopover t={t} open anchor={{ left: menu.x, top: menu.y, triggerTop: menu.y }}
          onClose={() => setMenu(null)} ariaLabel="Actions" columnWidth={228} maxHeight={420}
          nodes={menuNodesFor(menu.it)} />
      )}
    </div>
  )
}

// Le survol montre le bouton retirer, sauf pendant un glisser (sinon le bouton clignote sous le
// curseur qui traverse les tuiles voisines) — délégué en CSS globalement plutôt qu'en JS par tuile.
if (typeof document !== 'undefined' && !document.getElementById('zr-gallery-hover-css')) {
  const s = document.createElement('style')
  s.id = 'zr-gallery-hover-css'
  s.textContent = '.zr-tap:hover .zr-gallery-remove{opacity:1}'
  document.head.appendChild(s)
}

// AJOUT DEPUIS LE MENU CONTEXTUEL DE CREATE (clic droit → « Ajouter à… » → une des galeries du
// registre). Accepte plusieurs entrées à la fois (sélection multiple). `w`/`h` copiés depuis le
// manifeste au moment de l'ajout, PAS relus dynamiquement ensuite : la grille doit rester stable même
// si l'image d'origine est retaillée plus tard, exactement le même choix que les vignettes en cache.
// Cible TOUJOURS la racine de la galerie visée (jamais un groupe précis) : depuis Create, il n'existe
// aucune notion de groupe à choisir, exactement comme avant le 2026-08-21.
export async function ajouterAGalerie(galleryKey, entrees) {
  const gallery = galleryByKey(galleryKey)
  if (!gallery) return false
  const items = entrees.filter(Boolean).map((e) => ({
    id: `g-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`,
    kind: e.kind, path: e.path, name: e.name, w: e.w || null, h: e.h || null,
    addedAt: new Date().toISOString(),
  }))
  if (!items.length) return false
  const res = await saveJsonWithRetry(gallery.path, (cur) => ({
    ...(cur || {}), v: 1, items: [...((cur && cur.items) || []), ...items],
  }))
  if (res.ok) {
    window.dispatchEvent(new CustomEvent(`zr:gallery-changed:${galleryKey}`))
    notify({ label: gallery.label, title: items.length > 1 ? `${items.length} éléments ajoutés` : `Ajouté à ${gallery.label}`, body: items.map((i) => i.name).slice(0, 3).join(', ') + (items.length > 3 ? '…' : '') })
    return true
  }
  notify({ kind: 'error', label: gallery.label, title: 'Ajout non enregistré', body: String(res.error || 'échec de sauvegarde') })
  return false
}
