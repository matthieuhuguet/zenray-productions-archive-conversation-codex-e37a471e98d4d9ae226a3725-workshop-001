import React, { useEffect, useState } from 'react'
import UnifiedViewer from './UnifiedViewer.jsx'
import { resolveEaglePath } from '../lib/eagleLink.js'

// Do not let individual viewers discover links themselves. Resolving here keeps
// every media engine (raw, HLS, MSE, YouTube, archive, image) on its canonical path.
export default function ResolvedUnifiedViewer({ path, ...props }) {
  const [resolved, setResolved] = useState(null)
  useEffect(() => {
    let live = true
    setResolved(null)
    resolveEaglePath(path).then((value) => { if (live) setResolved(value) })
    return () => { live = false }
  }, [path])
  if (!resolved) return <div style={{ padding: 24, color: props.t?.textSecondary || '#888' }}>résolution du lien…</div>
  if (resolved.error) return <div style={{ padding: 24, color: '#ff453a' }}>Lien média indisponible.</div>
  return <UnifiedViewer {...props} path={resolved.path} />
}
