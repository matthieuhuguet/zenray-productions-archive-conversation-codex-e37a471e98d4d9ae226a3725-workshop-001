// FR : logique pure de ZenRay Freelance, lecture de l'ancien schéma, historique daté, messages.
import { describe, it, expect } from 'vitest'
import { normalizeStore, normalizeStudio, setStatus, addMessage, lastMessage, groupByStatus, counts, timeline, searchStudios, readableDate, statusColor, applyStudioChange } from './freelanceStudios.js'
import { UI } from '../config/colors.js'

const base = () => normalizeStudio({ id: 's1', name: 'Sloclap', role: 'Tech artist', status: 'to_contact' })

describe('normalizeStore', () => {
  it('reads the legacy applications file so no past candidature is lost', () => {
    const st = normalizeStore({ applications: [{ id: 'a1', company: 'Quantic Dream', role: 'TA', date: '2026-08-02', status: 'Entretien', notes: 'n' }] })
    expect(st.v).toBe(2)
    expect(st.studios[0]).toMatchObject({ name: 'Quantic Dream', status: 'interview', createdAt: '2026-08-02', contactedAt: '2026-08-02' })
  })
  it('reads the v2 file and drops a nameless row instead of showing an empty card', () => {
    const st = normalizeStore({ v: 2, studios: [{ id: 's1', name: 'Dontnod', status: 'contacted' }, { id: 's2', role: 'nothing' }] })
    expect(st.studios).toHaveLength(1)
    expect(st.studios[0].status).toBe('contacted')
  })
  it('never throws on a broken file', () => {
    expect(normalizeStore(null).studios).toEqual([])
    expect(normalizeStore({ studios: 'oops' }).studios).toEqual([])
  })
})

describe('setStatus', () => {
  it('appends a dated event and stamps the first contact date', () => {
    const s = setStatus(base(), 'contacted', '2026-09-12')
    expect(s.status).toBe('contacted')
    expect(s.contactedAt).toBe('2026-09-12')
    expect(s.history).toEqual([{ at: '2026-09-12', from: 'to_contact', to: 'contacted', note: '' }])
  })
  it('keeps the past intact on a later change, and keeps the first contact date', () => {
    const s = setStatus(setStatus(base(), 'contacted', '2026-09-12'), 'interview', '2026-09-20')
    expect(s.history.map((h) => h.to)).toEqual(['contacted', 'interview'])
    expect(s.contactedAt).toBe('2026-09-12')
  })
  it('ignores an unknown status and a change to the same status', () => {
    expect(setStatus(base(), 'nope').history).toEqual([])
    expect(setStatus(base(), 'to_contact').history).toEqual([])
  })
})

describe('addMessage', () => {
  it('stores the exact text sent and turns the studio contacted by itself', () => {
    const s = addMessage(base(), { text: '  Bonjour, je suis tech artist…  ', channel: 'linkedin', at: '2026-09-12' })
    expect(lastMessage(s)).toEqual({ at: '2026-09-12', channel: 'linkedin', text: 'Bonjour, je suis tech artist…' })
    expect(s.status).toBe('contacted')
    expect(s.history[0].note).toBe('premier message')
  })
  it('a second message does not change a status already further down the pipeline', () => {
    const s = addMessage(setStatus(base(), 'interview', '2026-09-13'), { text: 'relance', at: '2026-09-20' })
    expect(s.status).toBe('interview')
    expect(s.messages).toHaveLength(1)
  })
  it('refuses an empty message', () => {
    expect(addMessage(base(), { text: '   ' }).messages).toEqual([])
  })
})

describe('dashboard', () => {
  const list = [
    addMessage(base(), { text: 'a', at: '2026-09-12' }),
    normalizeStudio({ id: 's2', name: 'Asobo', status: 'to_contact' }),
    normalizeStudio({ id: 's3', name: 'Ubisoft', status: 'interview' }),
  ]
  it('groups by pipeline order and drops empty sections', () => {
    expect(groupByStatus(list).map((g) => g.key)).toEqual(['to_contact', 'contacted', 'interview'])
  })
  it('counts what Matthieu looks at: to contact, contacted, answered, messages', () => {
    expect(counts(list)).toEqual({ total: 3, toContact: 1, contacted: 2, answered: 1, messages: 1 })
  })
  it('the timeline is the progress backup, most recent first', () => {
    const older = setStatus(normalizeStudio({ id: 's4', name: 'Arkane', status: 'to_contact' }), 'contacted', '2026-08-01')
    const tl = timeline([...list, older])
    expect(tl[0].at >= tl[tl.length - 1].at).toBe(true)
    expect(tl.some((e) => e.kind === 'message' && e.text === 'a')).toBe(true)
    expect(tl.some((e) => e.kind === 'status' && e.studio === 'Arkane')).toBe(true)
  })
  it('searches the message text too, not only the studio name', () => {
    expect(searchStudios(list, 'sloclap').map((s) => s.name)).toEqual(['Sloclap'])
    expect(searchStudios(list, 'a').length).toBeGreaterThan(0)
    expect(searchStudios(list, '').length).toBe(3)
  })
})

describe('presentation', () => {
  it('formats a date in French and takes its colors from the palette', () => {
    expect(readableDate('2026-09-12')).toBe('12 septembre 2026')
    expect(readableDate('')).toBe('')
    expect(statusColor('contacted')).toBe(UI.orange)
    expect(statusColor('unknown')).toBe(UI.gray)
  })
})

// 30 September 2026, 19:49 Europe/Paris: A stale browser must retain newly imported offers and source files.
describe('concurrent catalogue changes', () => {
  it('records a message from a stale tab without losing the source detail or a new offer', () => {
    const before = base()
    const remoteMessage = { at: '2026-09-30', channel: 'discord', text: 'Message ajouté ailleurs' }
    const current = normalizeStore({ v: 2, batch: 'research', studios: [
      { ...before, offerDetailsPath: 'freelance/offers/s1.json', messages: [remoteMessage] },
      { id: 's2', name: 'Nouveau studio' },
    ] })
    const result = applyStudioChange(current, before, addMessage(before, { text: 'Bonjour', at: '2026-09-30' }))
    expect(result.batch).toBe('research')
    expect(result.studios).toHaveLength(2)
    expect(result.studios[0].offerDetailsPath).toBe('freelance/offers/s1.json')
    expect(result.studios[0].messages.map((message) => message.text)).toEqual(['Message ajouté ailleurs', 'Bonjour'])
  })
  it('refuses to overwrite notes edited elsewhere or resurrect a deleted studio', () => {
    const before = base()
    const current = normalizeStore({ studios: [{ ...before, notes: 'Nouvelles conditions' }] })
    expect(() => applyStudioChange(current, before, { ...before, notes: 'Mon texte' })).toThrow('autre onglet')
    expect(() => applyStudioChange({ studios: [] }, before, { ...before, notes: 'Mon texte' })).toThrow('supprimée')
  })
  it('can retry an applied change without duplicating messages or history', () => {
    const before = base()
    const next = addMessage(before, { text: 'Bonjour', at: '2026-09-30' })
    expect(applyStudioChange(normalizeStore({ studios: [next] }), before, next).studios[0]).toEqual(next)
  })
})
