/* 2026-09-23 20:15 : Progress view. Only site tokens (--g9-*, --zr-police-*, --zr-ui-*), no literal color. */
.zr-pg { max-width: 1080px; margin: 0 auto; padding: 8px 0 60px; font-family: var(--zr-police-sans); }
.zr-pg-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 22px; }
.zr-pg-title { font-family: var(--zr-police-serif); font-weight: 350; font-size: var(--zr-titre-1, 40px); margin: 0; letter-spacing: -0.01em; }
.zr-pg-sub { margin: 4px 0 0; color: var(--g9-muted); font-size: var(--zr-ui-sm, 13px); }
.zr-pg-badge { display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 999px; font-size: var(--zr-ui-sm, 13px);
  background: linear-gradient(180deg, var(--g9-glass-a), var(--g9-glass-b)); box-shadow: inset 0 0 0 1px var(--g9-rail), var(--g9-elev-a);
  backdrop-filter: blur(24px) saturate(180%); -webkit-backdrop-filter: blur(24px) saturate(180%); }
.zr-pg-dot { width: 8px; height: 8px; border-radius: 999px; flex: none; }
.zr-pg-dot.is-live { animation: zr-pg-pulse 1.8s var(--g9-ease) infinite; }
.zr-pg-hash { font-family: var(--zr-police-mono); color: var(--g9-soft); font-size: var(--zr-ui-xs, 12px); }
@keyframes zr-pg-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }

.zr-pg-strip { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(14px, 1fr); gap: 4px; height: 92px; padding: 10px 12px 6px;
  border-radius: 14px; background: linear-gradient(180deg, var(--g9-glass-a), var(--g9-glass-b)); box-shadow: inset 0 0 0 1px var(--g9-rail); overflow-x: auto; }
.zr-pg-cell { display: flex; flex-direction: column; align-items: stretch; gap: 4px; border: 0; background: none; padding: 0; cursor: pointer; color: var(--g9-soft); min-width: 14px; }
.zr-pg-bar { flex: 1; display: flex; flex-direction: column-reverse; border-radius: 4px; overflow: hidden; background: var(--g9-rail);
  transition: transform var(--zr-pg-anim) var(--g9-ease), box-shadow var(--zr-pg-anim) var(--g9-ease); }
.zr-pg-bar > span { display: block; transition: height var(--zr-pg-anim) var(--g9-ease); }
.zr-pg-num { font-family: var(--zr-police-serif); font-weight: 400; font-size: var(--zr-ui-xs, 12px); text-align: center; }
.zr-pg-cell.is-today .zr-pg-num { color: var(--g9-fg); }
.zr-pg-cell.is-on .zr-pg-bar { box-shadow: 0 0 0 2px var(--g9-fg); transform: translateY(-2px); }
.zr-pg-cell.is-on .zr-pg-num { color: var(--g9-fg); }

.zr-pg-day { margin: 26px 0 8px; }
.zr-pg-dayhead { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
.zr-pg-daytitle { font-family: var(--zr-police-serif); font-weight: 350; font-size: var(--zr-titre-2, 28px); margin: 0; text-transform: capitalize; }
.zr-pg-total { font-family: var(--zr-police-serif); font-weight: 400; color: var(--g9-muted); }
.zr-pg-actions { margin-left: auto; display: inline-flex; gap: 8px; }
.zr-pg-actions button, .zr-pg-more, .zr-pg-chip { font: inherit; font-size: var(--zr-ui-sm, 13px); color: var(--g9-fg); border: 0; cursor: pointer; border-radius: 999px; padding: 6px 12px;
  background: linear-gradient(180deg, var(--g9-glass-a), var(--g9-glass-b)); box-shadow: inset 0 0 0 1px var(--g9-rail);
  transition: box-shadow var(--zr-pg-anim) var(--g9-ease), transform var(--zr-pg-anim) var(--g9-ease); }
.zr-pg-actions button:active, .zr-pg-chip:active { transform: scale(.97); }
.zr-pg-domains { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
.zr-pg-chip { display: inline-flex; align-items: center; gap: 8px; }
.zr-pg-chip.is-on { box-shadow: inset 0 0 0 1.5px var(--zr-pg-c); }
.zr-pg-chipdot { width: 8px; height: 8px; border-radius: 999px; background: var(--zr-pg-c); }
.zr-pg-chipnum { font-family: var(--zr-police-serif); font-weight: 400; color: var(--g9-muted); }
.zr-pg-tools { display: flex; gap: 8px; margin-top: 14px; }
.zr-pg-search, .zr-pg-filter { font: inherit; font-size: var(--zr-ui-sm, 13px); color: var(--g9-fg); border: 0; border-radius: 10px; padding: 8px 12px;
  background: linear-gradient(180deg, var(--g9-toolbar-glass-a, var(--g9-glass-a)), var(--g9-toolbar-glass-b, var(--g9-glass-b))); box-shadow: inset 0 0 0 1px var(--g9-rail); }
.zr-pg-search { flex: 1; min-width: 0; }

.zr-pg-rail { list-style: none; margin: 18px 0 0; padding: 0; position: relative; }
.zr-pg-rail::before { content: ''; position: absolute; left: 67px; top: 6px; bottom: 6px; width: 1px; background: var(--g9-rail); }
.zr-pg-entry { display: grid; grid-template-columns: 52px 30px 1fr; align-items: start; padding: 6px 0;
  animation: zr-pg-in var(--zr-pg-anim) var(--g9-ease) both; }
.zr-pg-time { font-family: var(--zr-police-serif); font-weight: 400; color: var(--g9-muted); text-align: right; padding-top: 13px; font-size: var(--zr-ui-sm, 13px); }
.zr-pg-node { justify-self: center; margin-top: 16px; width: 9px; height: 9px; border-radius: 999px; background: var(--zr-pg-c); box-shadow: 0 0 0 4px var(--g9-bg); position: relative; z-index: 1; }
.zr-pg-card { padding: 11px 14px 12px; border-radius: 12px; background: linear-gradient(180deg, var(--g9-glass-a), var(--g9-glass-b));
  box-shadow: inset 0 0 0 1px var(--g9-rail); border-left: 2px solid var(--zr-pg-c); }
.zr-pg-entry.is-fresh .zr-pg-card { animation: zr-pg-flash 1.6s var(--g9-ease) 1; }
.zr-pg-meta { display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: var(--zr-ui-xs, 12px); color: var(--g9-muted); }
.zr-pg-domain { color: var(--zr-pg-c); }
.zr-pg-agent { color: var(--g9-soft); }
.zr-pg-tz { font-family: var(--zr-police-mono); color: var(--g9-soft); }
.zr-pg-fait { font-family: var(--zr-police-serif); font-weight: 350; font-size: var(--zr-corps-editeur, 16px); line-height: 1.45; margin: 6px 0 0; white-space: pre-line; }
.zr-pg-more { margin-top: 8px; padding: 4px 10px; font-size: var(--zr-ui-xs, 12px); }
.zr-pg-details { display: grid; grid-template-columns: max-content 1fr; gap: 6px 14px; margin: 10px 0 0; font-size: var(--zr-ui-sm, 13px); }
.zr-pg-details dt { color: var(--g9-muted); }
.zr-pg-details dd { margin: 0; white-space: pre-line; }
.zr-pg-sep { font-family: var(--zr-police-serif); font-weight: 350; font-size: var(--zr-titre-3, 20px); margin: 22px 0 6px 97px; text-transform: capitalize; }

@keyframes zr-pg-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
@keyframes zr-pg-flash { 0% { box-shadow: inset 0 0 0 1.5px var(--zr-pg-c), 0 0 24px var(--zr-pg-c); } 100% { box-shadow: inset 0 0 0 1px var(--g9-rail); } }
@media (prefers-reduced-motion: reduce) { .zr-pg-entry, .zr-pg-dot.is-live, .zr-pg-entry.is-fresh .zr-pg-card { animation: none; } }
@media (max-width: 680px) {
  .zr-pg-entry { grid-template-columns: 40px 22px 1fr; }
  .zr-pg-rail::before { left: 50px; }
  .zr-pg-sep { margin-left: 62px; }
  .zr-pg-actions { margin-left: 0; }
}
