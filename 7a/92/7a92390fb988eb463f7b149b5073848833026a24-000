const WEEKDAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']

export function planDayLabel(selectedIso, todayIso) {
  if (selectedIso === todayIso) return 'Today'
  const [year, month, day] = String(selectedIso || '').split('-').map(Number)
  const date = new Date(year, (month || 1) - 1, day || 1)
  return WEEKDAY_NAMES[date.getDay()]
}

export function planDateDirection(nextIso, previousIso) {
  if (nextIso === previousIso) return 'still'
  return nextIso < previousIso ? 'backward' : 'forward'
}
