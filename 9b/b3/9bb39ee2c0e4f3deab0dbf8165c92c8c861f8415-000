// subtitleSidecar.js : encode / decode a subtitle track stored inside a video manifest.
// Shape: { lang, label, format: 'ass'|'ssa', encoding: 'gzip+base64', data }.
// FR : piste de sous-titres rangee dans le manifeste video (ASS compresse en gzip puis base64).

export const SUB_ENCODING = 'gzip+base64'

// Browser and Node 18+ both ship DecompressionStream.
export async function decodeSubtitleText(spec) {
  if (!spec || typeof spec.data !== 'string') throw new Error('subtitle spec without data')
  if (spec.encoding !== SUB_ENCODING) throw new Error(`unknown subtitle encoding: ${spec.encoding}`)
  const bin = atob(spec.data)
  const bytes = new Uint8Array(bin.length)
  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i)
  const source = new ReadableStream({ start(c) { c.enqueue(bytes); c.close() } })
  const reader = source.pipeThrough(new DecompressionStream('gzip')).getReader()
  const chunks = []
  let total = 0
  for (;;) {
    const { done, value } = await reader.read()
    if (done) break
    chunks.push(value); total += value.length
  }
  const out = new Uint8Array(total)
  let at = 0
  for (const c of chunks) { out.set(c, at); at += c.length }
  return new TextDecoder('utf-8').decode(out)
}
